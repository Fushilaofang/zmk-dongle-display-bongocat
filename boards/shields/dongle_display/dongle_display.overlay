 &ydp154h008_v3_spi {
    status = "okay";
    ydp154h008_v3: ydp154h008_v3@0 {
        compatible = "sitronix,st7305";
        spi-max-frequency = <8000000>;
        reg = <0>;
        width = <200>;
        height = <200>;
        start-line = <0>;
        start-column = <0>;
        nvm-load = [00 00];
        gate-voltages = [1F 1F];
        vsh = [14 14 14 14];
        vsl = [14 14 14 14];
        vshn = [14 14 14 14];
        vsln = [14 14 14 14];
        osc-settings = <0x80>;
        framerate = <0x10>;
        multiplex-ratio = <50>;
        source-voltage = <0>;
        remap-value = <0x00>;
        panel-settings = <0x00>;
        hpm-gate-waveform = [E5 F6 05 46 77 77 77 77 76 45];
        lpm-gate-waveform = [05 46 77 77 77 77 76 45];
        inversion-on;
    };
};

/ {
    chosen {
        zephyr,display = &ydp154h008_v3;
    };
};
